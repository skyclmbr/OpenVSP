From e235ef3787fafe5a5b5fbcef81e684550f64270f Mon Sep 17 00:00:00 2001
From: Bryan Sandoz <17123735+skyclmbr@users.noreply.github.com>
Date: Wed, 1 Jul 2026 15:02:16 -0700
Subject: [PATCH] fix(win): CMake 4.x and MSVC external library build on
 Windows

Squashed toolchain layer for building OpenVSP on current Windows (CMake 4.x,
VS 2022+): policy minimums for Code-Eli/GLEW/STEPCode, LibXml2 MSVC install
workaround, STEPCODE extracted-source patch, build-vsp.cmd, win-build scripts,
and exported mailbox patch. Rebase onto origin/main each upstream release.

Co-authored-by: Cursor <cursoragent@cursor.com>

diff --git a/Libraries/cmake/External_CodeEli.cmake b/Libraries/cmake/External_CodeEli.cmake
index 3f517f193..6d6f673b1 100644
--- a/Libraries/cmake/External_CodeEli.cmake
+++ b/Libraries/cmake/External_CodeEli.cmake
@@ -2,6 +2,7 @@ ExternalProject_Add( CODEELI
 	URL ${CMAKE_SOURCE_DIR}/Code-Eli-709ed73905b8.zip
 	DOWNLOAD_EXTRACT_TIMESTAMP TRUE
 	CMAKE_ARGS -DCMAKE_INSTALL_PREFIX:PATH=<INSTALL_DIR>
+		-DCMAKE_POLICY_VERSION_MINIMUM=3.5
 		-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
 		-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
 		-DCMAKE_CXX_FLAGS=${CMAKE_CXX_FLAGS}
