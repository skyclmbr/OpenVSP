From ecc558e9ec5480358b37f608bdf3325aa3d4510e Mon Sep 17 00:00:00 2001
From: Bryan Sandoz <17123735+skyclmbr@users.noreply.github.com>
Date: Wed, 1 Jul 2026 15:06:20 -0700
Subject: [PATCH 25/26] fix(vr): use rev-parse for branch check on Windows

Co-authored-by: Cursor <cursoragent@cursor.com>

diff --git a/scripts/vr-build/export-patches.ps1 b/scripts/vr-build/export-patches.ps1
index 4b2af917c..9caa02bbe 100644
--- a/scripts/vr-build/export-patches.ps1
+++ b/scripts/vr-build/export-patches.ps1
@@ -8,7 +8,8 @@ $PatchDir = Join-Path $RepoRoot "patches\vr-build"
 
 Push-Location $RepoRoot
 try {
-    if (-not (git show-ref --verify --quiet refs/heads/bry/win-cmake)) {
+    git rev-parse --verify bry/win-cmake *> $null
+    if ($LASTEXITCODE -ne 0) {
         Write-Error "Branch bry/win-cmake not found."
     }
 
diff --git a/scripts/vr-build/rebase-on-upstream.ps1 b/scripts/vr-build/rebase-on-upstream.ps1
index e474cc433..d40146e1f 100644
--- a/scripts/vr-build/rebase-on-upstream.ps1
+++ b/scripts/vr-build/rebase-on-upstream.ps1
@@ -7,7 +7,8 @@ $RepoRoot = Resolve-Path (Join-Path $ScriptDir "..\..")
 
 Push-Location $RepoRoot
 try {
-    if (-not (git show-ref --verify --quiet refs/heads/bry/win-cmake)) {
+    git rev-parse --verify bry/win-cmake *> $null
+    if ($LASTEXITCODE -ne 0) {
         Write-Error "Branch bry/win-cmake not found. Create it first (see docs/win-build/WIN_BUILD.md)."
     }
 
-- 
