From 92245a4e7a1cb041cc296c6d9be9cc8de8fb9dd2 Mon Sep 17 00:00:00 2001
From: Bryan Sandoz <17123735+skyclmbr@users.noreply.github.com>
Date: Fri, 1 May 2026 14:18:19 -0700
Subject: [PATCH 13/23] refactor(vr): keep translation free in z-lock mode

Adjust z-lock interaction to constrain rotation only (yaw about world up) while preserving full 3D translation for single- and dual-grab manipulations.

Co-authored-by: Cursor <cursoragent@cursor.com>

diff --git a/src/vr/VRManager.cpp b/src/vr/VRManager.cpp
index eab937401..cd4d6168b 100644
--- a/src/vr/VRManager.cpp
+++ b/src/vr/VRManager.cpp
@@ -730,12 +730,12 @@ struct VRManager::Impl
                 modelScale = std::clamp( modelScale * factor, 0.01f, 50.0f );
             }
 
-            // Right thumbstick X: yaw around +Z (always active).
+            // Right thumbstick X: yaw around world up (+Y).
             if ( stickX != 0.0f )
             {
                 const float yawRate = 1.7f; // rad/s at full deflection
                 const float yaw = stickX * yawRate * dt;
-                const glm::quat yawRot = glm::angleAxis( yaw, glm::vec3( 0.0f, 0.0f, 1.0f ) );
+                const glm::quat yawRot = glm::angleAxis( yaw, glm::vec3( 0.0f, 1.0f, 0.0f ) );
                 modelRotation = glm::normalize( yawRot * modelRotation );
             }
         }
@@ -751,7 +751,7 @@ struct VRManager::Impl
                 // Short right click cycles preset views.
                 static const float kPresetYaw[4] = { 0.0f, 1.5707963f, 3.1415926f, 0.7853982f };
                 viewPresetIndex = ( viewPresetIndex + 1 ) % 4;
-                modelRotation = glm::angleAxis( kPresetYaw[viewPresetIndex], glm::vec3( 0.0f, 0.0f, 1.0f ) );
+                modelRotation = glm::angleAxis( kPresetYaw[viewPresetIndex], glm::vec3( 0.0f, 1.0f, 0.0f ) );
                 fprintf( stderr, "[VSP_VR] View preset %d\n", viewPresetIndex );
             }
             rightThumbHeldTime = 0.0f;
@@ -793,8 +793,8 @@ struct VRManager::Impl
             }
             if ( zLock )
             {
-                modelTranslation.x = twoGrabBaseTranslation.x + midDelta.x * scaleFactor;
-                modelTranslation.y = twoGrabBaseTranslation.y + midDelta.y * scaleFactor;
+                // Z-lock constrains rotation only; keep 3D translation enabled.
+                modelTranslation = twoGrabBaseTranslation + midDelta * scaleFactor;
             }
             else
             {
@@ -838,13 +838,13 @@ struct VRManager::Impl
 
             if ( zLock )
             {
-                modelTranslation.x = singleGrabBaseTranslation.x + deltaPos.x;
-                modelTranslation.y = singleGrabBaseTranslation.y + deltaPos.y;
+                // Z-lock constrains rotation only; keep 3D translation enabled.
+                modelTranslation = singleGrabBaseTranslation + deltaPos;
 
-                const float yaw = atan2f( 2.0f * ( deltaRot.w * deltaRot.z + deltaRot.x * deltaRot.y ),
+                const float yaw = atan2f( 2.0f * ( deltaRot.w * deltaRot.y + deltaRot.x * deltaRot.z ),
                                           1.0f - 2.0f * ( deltaRot.y * deltaRot.y + deltaRot.z * deltaRot.z ) );
                 const float yawFiltered = ( std::abs( yaw ) < 0.012f ) ? 0.0f : yaw;
-                const glm::quat yawOnly = glm::angleAxis( yawFiltered, glm::vec3( 0.0f, 0.0f, 1.0f ) );
+                const glm::quat yawOnly = glm::angleAxis( yawFiltered, glm::vec3( 0.0f, 1.0f, 0.0f ) );
                 modelRotation = glm::normalize( yawOnly * singleGrabBaseRotation );
             }
             else
