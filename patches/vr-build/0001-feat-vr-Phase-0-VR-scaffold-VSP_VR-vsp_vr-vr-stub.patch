+// version 1.3 as detailed in the LICENSE file which accompanies this software.
+//
+
+#include "VRMode.h"
+
+#include <cstdio>
+
+int RunVRMode( int argc, char **argv )
+{
+    ( void )argc;
+    ( void )argv;
+    printf( "[VSP_VR] VR mode scaffold is enabled, but runtime is not implemented yet.\n" );
+    return 1;
+}
