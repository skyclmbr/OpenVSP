From 55e1d07dbbb58c6d7088c16dd6394a2fa13e172e Mon Sep 17 00:00:00 2001
From: Bryan Sandoz <17123735+skyclmbr@users.noreply.github.com>
Date: Thu, 30 Apr 2026 21:43:11 -0700
Subject: [PATCH 01/23] feat(vr): Phase 0 VR scaffold (VSP_VR, vsp_vr, --vr
 stub)

Add optional VSP_VR build, static vsp_vr stubs, and guarded --vr entry that prints a placeholder until OpenXR runtime is wired.

Made-with: Cursor

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 48a03c316..95cc3356a 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -14,6 +14,9 @@ MESSAGE( STATUS "CMake version: ${CMAKE_VERSION}" )
 
 SET( CMAKE_CXX_STANDARD 17 )
 
+# Optional VR scaffolding. Runtime features are added incrementally.
+option( VSP_VR "Build with experimental VR scaffolding" OFF )
+
 IF(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64" OR CMAKE_SYSTEM_PROCESSOR MATCHES "amd64")
   SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fPIC")
   SET(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fPIC")
@@ -162,6 +165,10 @@ SET( VSP_G_LIBRARIES_CORE_FIRST
     ${VSP_COMMON_LIBRARIES}
 )
 
+IF( VSP_VR AND NOT VSP_NO_GRAPHICS )
+	ADD_SUBDIRECTORY( vr )
+ENDIF()
+
 ADD_SUBDIRECTORY( vsp )
 
 set(IS_NUMPY_FOUND FALSE)
diff --git a/src/vr/CMakeLists.txt b/src/vr/CMakeLists.txt
new file mode 100644
index 000000000..44b0ac5b7
--- /dev/null
+++ b/src/vr/CMakeLists.txt
@@ -0,0 +1,7 @@
+add_library( vsp_vr STATIC
+    VRInterfaces.cpp
+    VRMode.cpp
+)
+
+target_compile_definitions( vsp_vr PUBLIC VSP_VR_ENABLED )
+target_include_directories( vsp_vr PUBLIC ${CMAKE_CURRENT_SOURCE_DIR} )
