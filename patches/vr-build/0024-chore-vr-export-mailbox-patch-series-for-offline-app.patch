+From 7e4f9f3927c1e42c87116f815aa350a1da6373fe Mon Sep 17 00:00:00 2001
+From: Bryan Sandoz <17123735+skyclmbr@users.noreply.github.com>
+Date: Thu, 30 Apr 2026 22:04:44 -0700
+Subject: [PATCH 03/23] feat(vr): Phase 1 OpenXR stereo demo (triangle)
+
+Add VRManager with Win32 OpenGL session, stage/view spaces, stereo swapchains, and per-eye triangle render. Fetch Khronos OpenXR-SDK by default; optional FindOpenXR via -DVSP_VR_SYSTEM_OPENXR=ON. Scope MSVC /MP to C/CXX only so nested OpenXR loader.rc builds. RunVRMode creates a hidden GL 3.3 context and drives the XR frame loop.
+
+diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
+index 95cc3356a..6c4147b43 100644
+--- a/src/CMakeLists.txt
++++ b/src/CMakeLists.txt
+@@ -27,7 +27,9 @@ IF( VSP_LIBRARY_PATH )
+ ENDIF( VSP_LIBRARY_PATH )
+ 
+ IF(WIN32)
+-    ADD_DEFINITIONS(/D _CRT_SECURE_NO_WARNINGS /D "NOMINMAX" /MP )
++    # /MP must not go through ADD_DEFINITIONS — it breaks MSVC rc.exe in nested projects (e.g. OpenXR loader).
++    ADD_DEFINITIONS(/D _CRT_SECURE_NO_WARNINGS /D "NOMINMAX" )
++    add_compile_options( $<$<COMPILE_LANGUAGE:CXX>:/MP> $<$<COMPILE_LANGUAGE:C>:/MP> )
+ ENDIF(WIN32)
+ 
+ IF(WIN32)
+diff --git a/src/cmake/FindOpenXR.cmake b/src/cmake/FindOpenXR.cmake
+new file mode 100644
+index 000000000..dbf8024b8
+--- /dev/null
++++ b/src/cmake/FindOpenXR.cmake
+@@ -0,0 +1,39 @@
++# FindOpenXR — locate Khronos OpenXR loader and headers (Windows / cross-platform).
++#
++# Sets:
++#   OpenXR_FOUND
++#   OpenXR_INCLUDE_DIR
++#   OpenXR_LOADER_LIBRARY
++# Target:
++#   OpenXR::openxr_loader
++#
++# Hints: OpenXR_ROOT, CMAKE_PREFIX_PATH, env OpenXR_SDK / OPENXR_SDK
++
++find_path( OpenXR_INCLUDE_DIR
++    NAMES openxr/openxr.h
++    HINTS
++        "${OpenXR_ROOT}"
++        "$ENV{OpenXR_SDK}"
++        "$ENV{OPENXR_SDK}"
++    PATH_SUFFIXES include
++)
++
++find_library( OpenXR_LOADER_LIBRARY
++    NAMES openxr_loader
++    HINTS
++        "${OpenXR_ROOT}"
++        "$ENV{OpenXR_SDK}"
++        "$ENV{OPENXR_SDK}"
++    PATH_SUFFIXES lib Lib/x64 lib/x64
++)
++
++include( FindPackageHandleStandardArgs )
++find_package_handle_standard_args( OpenXR DEFAULT_MSG OpenXR_INCLUDE_DIR OpenXR_LOADER_LIBRARY )
++
++if( OpenXR_FOUND )
++    add_library( OpenXR::openxr_loader UNKNOWN IMPORTED GLOBAL )
++    set_target_properties( OpenXR::openxr_loader PROPERTIES
++        IMPORTED_LOCATION "${OpenXR_LOADER_LIBRARY}"
++        INTERFACE_INCLUDE_DIRECTORIES "${OpenXR_INCLUDE_DIR}"
++    )
++endif()
